  "======================== 节点与边编码规范 ========================": {
    "description": "图谱可视化的节点/边编码规范。包括 ID 命名约定、属性字段约定、关系方向约定。"
  },

  "nodeSpec": {
    "idConvention": {
      "person": "p{id}，如 p1, p_zhangsan",
      "event": "e{id}，如 e1, e_20260601",
      "conversation": "c{id}，如 c1, c_conv_3"
    },
    "personProperties": {
      "role": { "type": "string", "description": "人物角色/职位" },
      "first_seen": { "type": "string", "format": "date-time", "description": "首次出现时间" }
    },
    "eventProperties": {
      "date": { "type": "string", "format": "date-time", "description": "事件日期" },
      "summary": { "type": "string", "description": "事件摘要" }
    },
    "conversationProperties": {
      "date": { "type": "string", "format": "date-time", "description": "对话发生时间" },
      "speaker_count": { "type": "integer", "description": "参与说话人数" },
      "summary": { "type": "string", "description": "对话摘要" }
    },
    "relationDirection": {
      "参与": "person → event（人物参与了事件）",
      "提及": "person → conversation（人物在对话中被提及）",
      "触发": "event → conversation（事件触发了对话讨论）",
      "相关": "person → person（人物间存在关联）"
    }
  },

  "======================== 渲染配置规范 ========================": {
    "description": "前端渲染样式配置。由 GraphConfig.ts 定义，可通过修改该文件自定义外观。"

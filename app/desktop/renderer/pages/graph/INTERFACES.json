    "======================== 入口四：后端 GraphStore (graph_store.py) ========================": {},

    "GraphStore": {
      "description": "Python 后端图存储服务。基于 NetworkX 实现。提供节点/边 CRUD、图查询、SQLite 重建、JSON 持久化。",
      "constructor": {
        "type": "object",
        "properties": {
          "storage_path": {
            "type": "string",
            "description": "JSON 持久化文件路径。为 None 时仅内存运行。",
            "default": "None"
          }
        }
      },

      "methods": {
        "initialize": {
          "description": "初始化。如已设置 storage_path，从 JSON 文件加载现有图数据。",
          "input": {},
          "output": { "type": "void" }
        },

        "add_person_node": {
          "description": "添加/更新人物节点。已存在的节点会更新属性和标签。",
          "input": {
            "type": "object",
            "required": ["person_id", "name"],
            "properties": {
              "person_id": { "type": "string", "description": "人物 ID，建议格式 p{id}" },
              "name": { "type": "string", "description": "人物名称" },
              "properties": { "type": "object", "description": "附加属性，如 role、first_seen" }
            }
          },
          "output": { "type": "string", "description": "返回 person_id" }
        },

        "add_conversation_node": {
          "description": "添加/更新对话节点。",
          "input": {
            "type": "object",
            "required": ["conversation_id", "title"],
            "properties": {
              "conversation_id": { "type": "string", "description": "对话 ID，建议格式 c{id}" },
              "title": { "type": "string", "description": "对话标题" },
              "properties": { "type": "object", "description": "如 date、speaker_count" }
            }
          },
          "output": { "type": "string" }
        },

        "add_event_node": {
          "description": "添加/更新事件节点。",
          "input": {
            "type": "object",
            "required": ["event_id", "event_type", "content"],
            "properties": {
              "event_id": { "type": "string", "description": "事件 ID，建议格式 e{id}" },
              "event_type": { "type": "string", "description": "事件类型，如『需求评审会』" },
              "content": { "type": "string", "description": "事件摘要" },
              "properties": { "type": "object", "description": "如 date、summary" }
            }
          },
          "output": { "type": "string" }
        },

        "add_edge": {
          "description": "添加关系边。会自动检查起止节点是否存在。",
          "input": {
            "type": "object",
            "required": ["from_id", "to_id", "relation"],
            "properties": {
              "from_id": { "type": "string", "description": "源节点 ID" },
              "to_id": { "type": "string", "description": "目标节点 ID" },
              "relation": {
                "type": "string",
                "enum": ["参与", "提及", "触发", "相关"],
                "description": "关系类型"
              },
              "properties": { "type": "object", "description": "如 weight" }
            }
          },
          "output": { "type": "boolean", "description": "添加成功返回 true，节点不存在返回 false" }
        },

        "remove_node": {
          "description": "删除节点及其所有关联边。",
          "input": {
            "type": "object",
            "required": ["node_id"],
            "properties": { "node_id": { "type": "string" } }
          },
          "output": { "type": "boolean" }
        },

        "get_node": {
          "description": "获取单个节点详情。",
          "input": {
            "type": "object",
            "required": ["node_id"],
            "properties": { "node_id": { "type": "string" } }
          },
          "output": {
            "description": "节点字典。不存在返回 None。",
            "oneOf": [{ "$ref": "#/modules/GraphNode" }, { "type": "null" }]
          }
        },

        "query_triples": {
          "description": "查询三元组（与前端 GraphService.queryTriples 完全对齐）。支持多条件组合筛选。",
          "input": {
            "type": "object",
            "properties": {
              "filters": {
                "type": "object",
                "description": "筛选条件（与 GraphFilters 结构一致）。",
                "properties": {
                  "time_range": {
                    "type": "object",
                    "description": "时间范围。仅对事件节点按 properties.date 过滤。",
                    "properties": {
                      "start": { "type": "string", "format": "date-time" },
                      "end": { "type": "string", "format": "date-time" }
                    }
                  },
                  "person_id": { "type": "string" },
                  "relation_type": { "type": "string", "enum": ["参与", "提及", "触发", "相关"] }
                }
              }
            }
          },
          "output": { "$ref": "#/modules/GraphData" }
        },

        "get_person_graph": {
          "description": "获取以某人为中心的局部子图。后端使用 NetworkX 的 neighbors() 做 BFS 遍历。",
          "input": {
            "type": "object",
            "required": ["person_id"],
            "properties": {
              "person_id": { "type": "string" },
              "depth": { "type": "integer", "default": 2, "minimum": 1, "maximum": 10 }
            }
          },
          "output": { "$ref": "#/modules/GraphData" }
        },

        "get_conversation_graph": {
          "description": "获取某对话的完整事件-人物关系图。委托给 get_person_graph。",
          "input": {
            "type": "object",
            "required": ["conversation_id"],
            "properties": { "conversation_id": { "type": "string" } }
          },
          "output": { "$ref": "#/modules/GraphData" }
        },

        "get_stats": {
          "description": "获取图统计信息。",
          "input": {},
          "output": {
            "type": "object",
            "required": ["nodeCount", "edgeCount", "personCount", "eventCount", "conversationCount"],
            "properties": {
              "nodeCount": { "type": "integer" },
              "edgeCount": { "type": "integer" },
              "personCount": { "type": "integer" },
              "eventCount": { "type": "integer" },
              "conversationCount": { "type": "integer" },
              "nodeTypes": { "type": "object", "description": "各节点类型分布字典" },
              "edgeTypes": { "type": "object", "description": "各关系类型分布字典" }
            }
          }
        },

        "rebuild_from_sqlite": {
          "description": "从 SQLite 数据库全量重建图数据。遍历 Person/Conversation/Event/Segment 表，重新创建所有节点和关系边。",
          "input": {},
          "output": { "type": "void" }
        },

        "save": {
          "description": "持久化当前图数据为 JSON 文件（保存到 initialization 时设置的 storage_path）。",
          "input": {},
          "output": { "type": "void" }
        }
      }
    },


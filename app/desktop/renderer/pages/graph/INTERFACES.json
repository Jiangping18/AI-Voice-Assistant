{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "知识图谱可视化模块 - 外部接口定义 (JSON Schema)",
  "description": "本文件以 JSON Schema 格式描述知识图谱可视化模块（智能体7）对外暴露的所有接口，包括前端 GraphService 查询接口、GraphRenderer 渲染控制接口、后端 GraphStore 数据接口、移动端 WebView JS Bridge 通信协议、以及各类数据格式。",
  "lastUpdated": "2026-06-13",

  "modules": {

    "======================== 核心数据类型 ========================": {},

    "GraphNode": {
      "description": "图节点。表示知识图谱中的一个实体（人物/事件/对话）。类型决定渲染形状和颜色。",
      "type": "object",
      "required": ["id", "type", "label"],
      "properties": {
        "id": {
          "type": "string",
          "description": "全局唯一节点标识符。命名约定：人物 p{id}、事件 e{id}、对话 c{id}。",
          "examples": ["p1", "e_20260601", "c_conv_3"]
        },
        "type": {
          "type": "string",
          "enum": ["person", "event", "conversation"],
          "description": "节点类型。决定渲染形状（人物圆形、事件方形、对话菱形）和颜色。"
        },
        "label": {
          "type": "string",
          "description": "节点显示标签。移动端自动截断至 6 个字符。",
          "examples": ["张三", "需求评审会", "项目启动讨论"]
        },
        "properties": {
          "type": "object",
          "description": "节点附加属性。不同类型携带不同字段。"
        },
        "x": {
          "type": "number",
          "description": "节点在画布上的 X 坐标。由力导向布局引擎计算，输入时可省略。",
          "default": "布局引擎自动计算"
        },
        "y": {
          "type": "number",
          "description": "节点在画布上的 Y 坐标。由力导向布局引擎计算，输入时可省略。",
          "default": "布局引擎自动计算"
        }
      },
      "examples": [
        { "id": "p1", "type": "person", "label": "张三", "properties": { "role": "项目经理", "first_seen": "2026-05-14T00:00:00Z" } },
        { "id": "e1", "type": "event", "label": "需求评审会", "properties": { "date": "2026-05-30T00:00:00Z", "summary": "讨论 v2.0 新功能" } },
        { "id": "c1", "type": "conversation", "label": "项目启动讨论", "properties": { "date": "2026-05-14T00:00:00Z", "speaker_count": 3 } }
      ]
    },

    "GraphEdge": {
      "description": "图边。表示两个节点之间的关系。关系类型决定边的颜色和方向箭头。",
      "type": "object",
      "required": ["source", "target", "relation"],
      "properties": {
        "source": {
          "type": "string",
          "description": "源节点 ID。必须存在于同一次 queryTriples 返回的 nodes 列表中。"
        },
        "target": {
          "type": "string",
          "description": "目标节点 ID。必须存在于同一次 queryTriples 返回的 nodes 列表中。"
        },
        "relation": {
          "type": "string",
          "enum": ["参与", "提及", "触发", "相关"],
          "description": "关系类型。参与=人物→事件，提及=人物→对话，触发=事件→对话，相关=人物→人物。",
          "examples": ["参与", "提及", "触发", "相关"]
        },
        "properties": {
          "type": "object",
          "description": "关系附加属性。",
          "properties": {
            "weight": {
              "type": "number",
              "description": "关系权重（0~1）。影响边渲染粗细和力导向布局中的引力强度。",
              "minimum": 0,
              "maximum": 1,
              "default": 0.5
            }
          }
        }
      },
      "examples": [
        { "source": "p1", "target": "e1", "relation": "参与", "properties": { "weight": 1.0 } },
        { "source": "p1", "target": "c1", "relation": "提及", "properties": { "weight": 0.6 } },
        { "source": "e1", "target": "c1", "relation": "触发", "properties": { "weight": 0.5 } },
        { "source": "p1", "target": "p2", "relation": "相关", "properties": { "weight": 0.4 } }
      ]
    },

    "GraphData": {
      "description": "完整图数据。是智能体5→智能体7、前端GraphService→GraphRenderer、后端→前端的核心交换格式。",
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "description": "节点列表。PC端无数量限制，移动端自动裁剪至 ≤50 个节点。",
          "items": { "$ref": "#/modules/GraphNode" }
        },
        "edges": {
          "type": "array",
          "description": "边列表。移动端仅保留选中节点内部的边（两层 BFS 剪枝）。",
          "items": { "$ref": "#/modules/GraphEdge" }
        }
      }
    },

    "GraphFilters": {
      "description": "查询筛选条件。所有字段可选，不传则返回全量数据。",
      "type": "object",
      "properties": {
        "time_range": {
          "type": "object",
          "description": "时间范围筛选。仅对 type=event 的节点生效（根据 properties.date 字段匹配）。人物和对话节点不过滤。",
          "required": ["start", "end"],
          "properties": {
            "start": {
              "type": "string",
              "format": "date-time",
              "description": "起始时间（ISO8601，含边界）。",
              "examples": ["2026-01-01T00:00:00Z"]
            },
            "end": {
              "type": "string",
              "format": "date-time",
              "description": "结束时间（ISO8601，含边界）。",
              "examples": ["2026-06-13T23:59:59Z"]
            }
          }
        },
        "person_id": {
          "type": "string",
          "description": "人物筛选：仅返回以该人物为中心、depth=2 的局部子图。等同于调用 getPersonGraph。",
          "examples": ["p1", "p_zhangsan"]
        },
        "relation_type": {
          "type": "string",
          "enum": ["参与", "提及", "触发", "相关"],
          "description": "关系类型筛选：仅返回包含该关系类型的边，以及这些边两端的节点。"
        },
        "keyword": {
          "type": "string",
          "description": "搜索关键词（仅前端 GraphRenderer.search 使用）。不发送到后端，在前端做节点 label/properties 模糊匹配并高亮。",
          "examples": ["张", "评审", "v2.0"]
        }
      }
    },

    "GraphStats": {
      "description": "图统计信息。在搜索结果、导出数据、UI 统计栏中展示。",
      "type": "object",
      "required": ["nodeCount", "edgeCount", "personCount", "eventCount", "conversationCount"],
      "properties": {
        "nodeCount": { "type": "integer", "description": "节点总数", "minimum": 0 },
        "edgeCount": { "type": "integer", "description": "边总数", "minimum": 0 },
        "personCount": { "type": "integer", "description": "人物节点数", "minimum": 0 },
        "eventCount": { "type": "integer", "description": "事件节点数", "minimum": 0 },
        "conversationCount": { "type": "integer", "description": "对话节点数", "minimum": 0 }
      }
    },

    "NodeDetail": {
      "description": "节点详情。单击节点时由 GraphRenderer.getNodeDetail() 构建，在弹窗中展示。",
      "type": "object",
      "required": ["node", "relationships"],
      "properties": {
        "node": { "$ref": "#/modules/GraphNode", "description": "当前节点" },
        "relatedConversations": {
          "type": "array",
          "description": "关联的对话标签列表（通过『提及』关系关联）。",
          "items": { "type": "string" }
        },
        "relatedEvents": {
          "type": "array",
          "description": "关联的事件标签列表（通过『参与』关系关联）。",
          "items": { "type": "string" }
        },
        "relationships": {
          "type": "array",
          "description": "当前节点所有直接关系。",
          "items": {
            "type": "object",
            "required": ["targetLabel", "relation"],
            "properties": {
              "targetLabel": { "type": "string", "description": "对端节点标签" },
              "relation": { "type": "string", "description": "关系类型" }
            }
          }
        }
      }
    },

    "ExportData": {
      "description": "导出 JSON 的顶层包装结构。exportGraphJSON() 的输出格式。",
      "type": "object",
      "required": ["version", "exportedAt", "filters", "data", "stats"],
      "properties": {
        "version": {
          "type": "string",
          "description": "导出格式版本号，用于向后兼容。",
          "enum": ["1.0"]
        },
        "exportedAt": {
          "type": "string",
          "format": "date-time",
          "description": "导出时间（ISO8601）。"
        },
        "filters": {
          "$ref": "#/modules/GraphFilters",
          "description": "导出时的筛选条件。"
        },
        "data": {
          "$ref": "#/modules/GraphData",
          "description": "筛选后的图数据。"
        },
        "stats": {
          "$ref": "#/modules/GraphStats",
          "description": "筛选后的统计信息。"
        }
      }
    },

    "DataUpdateEvent": {
      "description": "数据更新推送事件。GraphService.subscribe() 的回调参数格式。",
      "type": "object",
      "required": ["type", "timestamp", "data"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["full", "incremental"],
          "description": "更新类型。full=全量替换，incremental=增量追加（节点和边追加到现有数据）。"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "事件发生时间（ISO8601）。"
        },
        "data": {
          "$ref": "#/modules/GraphData",
          "description": "更新后的完整或增量数据。收到 full 类型时调用方应替换全部数据，收到 incremental 类型时应合并到现有数据。"
        }
      }
    },

    "======================== 入口一：前端 GraphService (GraphService.ts) ========================": {},

    "GraphService": {
      "description": "图数据服务类。封装与后端/智能体5的通信，提供查询、筛选、订阅和增量更新功能。使用单例模式，通过 graphService 实例访问。",
      "methods": {
        "initialize": {
          "description": "初始化服务。加载初始数据并触发一次全量通知。必须在首次 queryTriples 前调用。",
          "input": {},
          "output": { "type": "void" }
        },
        "queryTriples": {
          "description": "查询三元组（核心查询接口，与智能体5协议对齐）。模拟延迟 300~500ms。",
          "input": {
            "type": "object",
            "properties": {
              "filters": {
                "$ref": "#/modules/GraphFilters",
                "description": "筛选条件。不传则返回全部缓存数据。",
                "default": {}
              }
            }
          },
          "output": {
            "type": "Promise",
            "items": { "$ref": "#/modules/GraphData" }
          },
          "errors": [
            { "type": "Error", "description": "网络请求失败（后端不可达）" },
            { "type": "Error", "description": "数据解析失败（后端返回格式错误）" }
          ]
        },
        "getPersonGraph": {
          "description": "获取以某人为中心的局部子图。内部使用 BFS 遍历 depth 层。",
          "input": {
            "type": "object",
            "required": ["personId"],
            "properties": {
              "personId": {
                "type": "string",
                "description": "中心人物节点 ID。",
                "examples": ["p1"]
              },
              "depth": {
                "type": "integer",
                "description": "BFS 搜索深度（关系层数）。默认 2 层。",
                "default": 2,
                "minimum": 1,
                "maximum": 5
              }
            }
          },
          "output": {
            "type": "Promise",
            "items": { "$ref": "#/modules/GraphData" }
          }
        },
        "subscribe": {
          "description": "订阅数据更新。自动接收增量/全量推送。返回取消订阅函数。",
          "input": {
            "type": "object",
            "required": ["callback"],
            "properties": {
              "callback": {
                "type": "function",
                "signature": "(event: DataUpdateEvent) => void",
                "description": "数据更新回调。每次有数据变更时调用，参数为 DataUpdateEvent。"
              }
            }
          },
          "output": {
            "type": "function",
            "signature": "() => void",
            "description": "取消订阅函数。调用后不再接收推送。"
          }
        },
        "unsubscribe": {
          "description": "取消订阅。与 subscribe 返回的取消函数等效。",
          "input": {
            "type": "object",
            "required": ["callback"],
            "properties": {
              "callback": { "type": "function", "description": "之前传入 subscribe 的回调引用。" }
            }
          },
          "output": { "type": "void" }
        },
        "startPolling": {
          "description": "启动数据轮询。按固定间隔调用 _simulateUpdate 检查增量更新。模拟智能体5的推送机制。",
          "input": {
            "type": "object",
            "properties": {
              "intervalMs": {
                "type": "integer",
                "description": "轮询间隔（毫秒）。",
                "default": 30000,
                "minimum": 5000,
                "examples": [30000]
              }
            }
          },
          "output": { "type": "void" }
        },
        "stopPolling": {
          "description": "停止数据轮询。清除定时器。",
          "input": {},
          "output": { "type": "void" }
        },
        "refresh": {
          "description": "手动触发全量刷新。调用后更新缓存并通知所有订阅者。",
          "input": {},
          "output": {
            "type": "Promise",
            "items": { "$ref": "#/modules/GraphData" }
          }
        }
      }
    },

    "======================== 入口二：前端 GraphRenderer (GraphRenderer.ts) ========================": {},

    "GraphRenderer": {
      "description": "基于 AntV G6 的图谱渲染器。负责画布初始化、节点/边渲染、交互事件、搜索高亮、截图导出。PC端使用。",
      "constructor": {
        "type": "object",
        "required": ["containerId"],
        "properties": {
          "containerId": {
            "type": "string",
            "description": "容器 DOM 元素的 ID。该元素必须有明确宽高。",
            "examples": ["graph-container"]
          }
        }
      },
      "methods": {
        "render": {
          "description": "渲染/重绘完整图谱。首次调用时初始化 G6 画布。",
          "input": {
            "type": "object",
            "required": ["data"],
            "properties": {
              "data": {
                "$ref": "#/modules/GraphData",
                "description": "要渲染的图数据。内部自动转换为 G6 格式。"
              }
            }
          },
          "output": { "type": "void" }
        },
        "updateData": {
          "description": "增量更新。调用 G6.changeData 实现，不会触发全量重排。",
          "input": {
            "type": "object",
            "required": ["data"],
            "properties": {
              "data": { "$ref": "#/modules/GraphData" }
            }
          },
          "output": { "type": "void" }
        },
        "fitView": {
          "description": "适配画布至容器尺寸。",
          "input": {
            "type": "object",
            "properties": {
              "padding": {
                "type": "integer",
                "description": "画布边缘留白像素。",
                "default": 40
              }
            }
          },
          "output": { "type": "void" }
        },
        "search": {
          "description": "按关键词搜索节点并高亮。匹配节点的 label 和 properties 值（大小写不敏感）。匹配节点高亮为黄色，其他节点半透明。",
          "input": {
            "type": "object",
            "required": ["keyword"],
            "properties": {
              "keyword": {
                "type": "string",
                "description": "搜索关键词。空字符串或纯空格清除高亮。",
                "examples": ["张", "评审", "v2.0"]
              }
            }
          },
          "output": {
            "type": "array",
            "description": "匹配的节点 ID 列表。可用于在 UI 显示匹配数。",
            "items": { "type": "string" }
          }
        },
        "clearSearchHighlight": {
          "description": "清除搜索高亮，恢复所有节点原始颜色和不透明度。",
          "input": {},
          "output": { "type": "void" }
        },
        "highlightSubGraph": {
          "description": "高亮指定子图（节点集合）。其他节点和边变为 15% 透明度，适合人物筛选时聚焦显示。",
          "input": {
            "type": "object",
            "required": ["nodeIds"],
            "properties": {
              "nodeIds": {
                "type": "array",
                "description": "要高亮的节点 ID 集合。",
                "items": { "type": "string" }
              }
            }
          },
          "output": { "type": "void" }
        },
        "resetOpacity": {
          "description": "重置所有节点和边的不透明度为 1.0（清除 highlightSubGraph 效果）。",
          "input": {},
          "output": { "type": "void" }
        },
        "getNodeDetail": {
          "description": "获取节点详情。遍历当前渲染数据的边，聚合关联对话、事件和关系列表。",
          "input": {
            "type": "object",
            "required": ["nodeId"],
            "properties": {
              "nodeId": {
                "type": "string",
                "description": "要查询的节点 ID。必须存在于当前渲染数据中。",
                "examples": ["p1", "e1", "c1"]
              }
            }
          },
          "output": {
            "description": "节点详情对象。节点不存在时返回 null。",
            "oneOf": [
              { "$ref": "#/modules/NodeDetail" },
              { "type": "null" }
            ]
          }
        },
        "toPNG": {
          "description": "导出当前画布为 PNG 图片（dataURL 格式）。",
          "input": {},
          "output": {
            "type": "string",
            "description": "PNG 图片的 Data URL（data:image/png;base64,...）。可用于 <img> 展示或下载。为空字符串表示导出失败。"
          }
        },
        "destroy": {
          "description": "销毁画布。调用 G6.destroy 释放 WebGL/Canvas 资源。",
          "input": {},
          "output": { "type": "void" }
        },
        "on": {
          "description": "注册交互事件监听。",
          "input": {
            "type": "object",
            "required": ["eventType", "handler"],
            "properties": {
              "eventType": {
                "type": "string",
                "enum": ["node:click", "node:hover", "edge:hover", "canvas:click"],
                "description": "事件类型。"
              },
              "handler": {
                "type": "function",
                "description": "事件处理函数。参数为事件对象，payload 见下方『事件』章节。"
              }
            }
          },
          "output": { "type": "void" }
        },
        "off": {
          "description": "移除事件监听。",
          "input": {
            "type": "object",
            "required": ["eventType", "handler"],
            "properties": {
              "eventType": { "type": "string", "description": "事件类型。" },
              "handler": { "type": "function", "description": "之前注册的处理函数引用。" }
            }
          },
          "output": { "type": "void" }
        }
      },

      "events": {
        "node:click": {
          "description": "用户单击节点时触发。",
          "payload": {
            "type": "object",
            "required": ["nodeId"],
            "properties": {
              "nodeId": { "type": "string", "description": "被点击节点的 ID。" },
              "originalEvent": { "type": "object", "description": "G6 原始事件对象。" }
            }
          }
        },
        "node:hover": {
          "description": "鼠标进入节点时触发。触发时节点自动放大并增加阴影。",
          "payload": {
            "type": "object",
            "required": ["nodeId"],
            "properties": {
              "nodeId": { "type": "string", "description": "悬停节点的 ID。" }
            }
          }
        },
        "edge:hover": {
          "description": "鼠标进入边时触发。触发时边自动加粗并增加阴影。",
          "payload": {
            "type": "object",
            "required": ["edgeId"],
            "properties": {
              "edgeId": { "type": "string", "description": "悬停边的 G6 内部 ID。" }
            }
          }
        },
        "canvas:click": {
          "description": "用户单击画布空白区域时触发。触发时自动清除所有选中状态。",
          "payload": { "type": "object", "properties": {} }
        }
      },

      "interactions": {
        "description": "G6 内置交互模式。通过 modes.default 配置，无需额外代码。",
        "drag-canvas": {
          "description": "鼠标拖拽平移画布。按住鼠标左键拖拽即可平移。"
        },
        "zoom-canvas": {
          "description": "鼠标滚轮缩放。向上滚轮放大，向下滚轮缩小。"
        },
        "drag-node": {
          "description": "拖拽节点。按住节点拖拽可改变其位置，释放后固定。力导向布局会根据新位置重新平衡。"
        },
        "click-select": {
          "description": "单击选中节点/边。选中后再次单击同节点取消选中。"
        }
      }
    },

    "======================== 入口三：前端 GraphPanel (GraphPanel.ts) ========================": {},

    "GraphPanel": {
      "description": "图谱交互面板。组合搜索、筛选、导出、刷新、详情弹窗等功能。通过 DOM 事件驱动，不依赖框架。",
